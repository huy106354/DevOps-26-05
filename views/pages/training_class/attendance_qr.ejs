<div class="page-header">
  <div>
    <h1 class="page-title">Mở Điểm Danh Lớp Tập Huấn</h1>
    <p class="page-subtitle">Học viên quét mã QR phía dưới bằng thiết bị di động để tự động ghi nhận tham dự.</p>
  </div>
  <a href="/training/classes/<%= class_record.id %>" class="btn btn-secondary">
    ➔ Đóng màn hình QR
  </a>
</div>

<div class="panel" style="max-width: 480px; margin: 0 auto; text-align: center;">
  <div class="panel-header">
    <h3 class="panel-title"><%= session.session_date %></h3>
  </div>
  <div class="panel-body">
    
    <div class="qr-container">
      
      <!-- QR Image using free qrserver API -->
      <div class="qr-box" id="qr-box">
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=<%= encodeURIComponent(checkin_url) %>" alt="QR Code Điểm Danh" width="240" height="240" style="display: block;">
      </div>
      
      <div style="font-size: 14px; font-weight: 600; color: var(--text-secondary);">
        Hết hạn tự động sau:
      </div>
      
      <!-- Countdown ticking timer -->
      <div class="timer-box" id="countdown-timer">15:00</div>
      
      <div style="margin-top: 16px; font-size: 12px; color: var(--text-muted);">
        Địa chỉ IP & thông tin thiết bị sẽ được đối chiếu tự động.
      </div>
      
    </div>

    <!-- Instructions and direct checkin test link -->
    <div style="margin-top: 24px; padding: 14px; background-color: var(--primary-glow); border-radius: var(--radius-sm); border: 1px solid var(--primary); text-align: left;">
      <div style="font-weight: 700; font-size: 13px; color: var(--primary); margin-bottom: 6px;">🧪 Đường dẫn test nhanh (Simulated Scan):</div>
      <div style="font-size: 12px; line-height: 1.4;">
        Nếu đang phát triển cục bộ và không có điện thoại để quét, bạn có thể click trực tiếp link dưới đây để giả lập hành vi quét QR:
        <br>
        <a href="<%= checkin_url %>" target="_blank" style="font-weight: 600; text-decoration: underline; word-break: break-all;">
          <%= checkin_url %>
        </a>
      </div>
    </div>
    
  </div>
</div>

<!-- Ticking Countdown JS Script -->
<script>
  const end_time = <%= session.end_time %>;
  const timer_element = document.getElementById('countdown-timer');
  const qr_box = document.getElementById('qr-box');

  function tick() {
    const now = Date.now();
    const remaining = end_time - now;

    if (remaining <= 0) {
      timer_element.innerHTML = "MÃ QR ĐÃ HẾT HẠN";
      timer_element.style.color = "var(--danger)";
      qr_box.style.filter = "blur(6px) grayscale(1)";
      qr_box.style.pointerEvents = "none";
      clearInterval(interval);
      return;
    }

    const minutes = Math.floor(remaining / 60000);
    const seconds = Math.floor((remaining % 60000) / 1000);
    
    // Pad leading zero
    const mins_str = minutes < 10 ? '0' + minutes : minutes;
    const secs_str = seconds < 10 ? '0' + seconds : seconds;

    timer_element.innerHTML = `${mins_str}:${secs_str}`;
  }

  // Initial tick and run every second
  tick();
  const interval = setInterval(tick, 1000);
</script>

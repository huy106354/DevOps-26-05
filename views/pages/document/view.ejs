<script>
let currentPreviewFilename = '';

function openDocPreview(filename, sizeStr, userName, docNum, docSummary) {
  currentPreviewFilename = filename;
  
  document.getElementById('preview-filename').innerText = filename;
  document.getElementById('preview-filesize').innerText = sizeStr;
  document.getElementById('preview-doc-number').innerText = docNum;
  document.getElementById('preview-doc-summary').innerText = docSummary;
  
  const modal = document.getElementById('doc-preview-modal');
  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden'; // Lock body scroll
}

function closeDocPreview() {
  const modal = document.getElementById('doc-preview-modal');
  modal.style.display = 'none';
  document.body.style.overflow = ''; // Restore body scroll
}

function triggerMockDownload() {
  const toast = document.getElementById('toast-notify');
  document.getElementById('toast-message').innerText = `Đang tải xuống tệp: ${currentPreviewFilename}...`;
  toast.style.display = 'block';
  
  setTimeout(() => {
    toast.style.display = 'none';
  }, 3000);
}

// Close modal when clicking outside the card
document.getElementById('doc-preview-modal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeDocPreview();
  }
});
</script>

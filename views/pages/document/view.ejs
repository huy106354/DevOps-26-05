<div class="page-header">
  <div>
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
      <% if (document.doc_type === 'incoming') { %>
        <span class="badge badge-primary">Đến 📥</span>
      <% } else { %>
        <span class="badge badge-success">Đi 📤</span>
      <% } %>
      <span class="badge badge-warning" style="font-family: monospace; font-size: 13px;"><%= document.doc_number %></span>
      <h1 class="page-title" style="margin: 0;"><%= document.summary %></h1>
    </div>
    <p class="page-subtitle">Cơ quan phát hành: <strong><%= document.issuing_agency %></strong> | Ngày tiếp nhận: <strong><%= new Date(document.received_sent_date).toLocaleDateString('vi-VN') %></strong></p>
  </div>
  <a href="/documents" class="btn btn-secondary">
    ➔ Danh sách công văn
  </a>
</div>

<!-- Class Profile Dashboard Stats -->
<div class="grid-stats" style="margin-bottom: 28px;">
  <div class="stat-card" style="padding: 16px 20px;">
    <div>
      <div class="stat-label" style="font-size: 11px;">Độ khẩn</div>
      <div style="font-weight: 700; font-size: 14px; margin-top: 4px;">
        <% if (document.urgency === 'express') { %>
          <span class="badge badge-danger">Hỏa tốc 🔥</span>
        <% } else if (document.urgency === 'high') { %>
          <span class="badge badge-warning">Khẩn ⚡</span>
        <% } else { %>
          <span class="badge badge-info">Bình thường</span>
        <% } %>
      </div>
    </div>
  </div>
  <div class="stat-card" style="padding: 16px 20px;">
    <div>
      <div class="stat-label" style="font-size: 11px;">Độ mật</div>
      <div style="font-weight: 700; font-size: 14px; margin-top: 4px;">
        <% if (document.confidentiality === 'top_secret') { %>
          <span class="badge badge-danger">Tối mật 🔒</span>
        <% } else if (document.confidentiality === 'confidential') { %>
          <span class="badge badge-warning">Mật 🛡️</span>
        <% } else { %>
          <span class="badge badge-primary">Bình thường</span>
        <% } %>
      </div>
    </div>
  </div>
  <div class="stat-card" style="padding: 16px 20px;">
    <div>
      <div class="stat-label" style="font-size: 11px;">Trạng thái hiện tại</div>
      <div style="font-weight: 700; font-size: 15px; margin-top: 4px;">
        <% if (document.status === 'completed') { %>
          <span class="badge badge-success">Đã hoàn thành</span>
        <% } else if (document.status === 'processing') { %>
          <span class="badge badge-warning">Đang xử lý</span>
        <% } else if (document.status === 'assigned') { %>
          <span class="badge badge-info">Đã chuyển giao</span>
        <% } else { %>
          <span class="badge badge-primary">Mới tiếp nhận</span>
        <% } %>
      </div>
    </div>
  </div>
  <div class="stat-card" style="padding: 16px 20px;">
    <div>
      <div class="stat-label" style="font-size: 11px;">Tệp số hóa đính kèm</div>
      <div style="font-weight: 700; font-size: 13px; margin-top: 4px;">
        <% if (attachments.length === 0) { %>
          <span style="color: var(--text-muted);">Không có tệp</span>
        <% } else { %>
          <% attachments.forEach(function(att) { %>
            <a href="#" onclick="openDocPreview('<%= att.filename %>', '<%= Math.round(att.size / 1024) %>KB', '<%= current_user.full_name %>', '<%= document.doc_number %>', '<%= document.summary.replace(/'/g, '\\\'').replace(/\n/g, ' ') %>'); return false;" style="font-weight: 600; text-decoration: underline; color: var(--primary);">
              💾 <%= att.filename %> (<%= Math.round(att.size / 1024) %>KB)
            </a>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Main Details Panels layout -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 32px;">
  
  <!-- LEFT SIDE: TIMELINE & DISCUSSIONS -->
  <div>
    
    <!-- Active Assignments Block -->
    <% if (document.doc_type === 'incoming') { %>
      <div class="panel">
        <div class="panel-header">
          <h3 class="panel-title">👥 Phân công giao việc xử lý</h3>
        </div>
        <div class="panel-body" style="padding: 0;">
          <% if (assignments.length === 0) { %>
            <div style="padding: 24px; text-align: center; color: var(--text-muted); font-size: 13px;">
              Chưa có phiếu chuyển giao xử lý nào. Hãy dùng bảng giao việc bên phải để phân công cán bộ phụ trách!
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="custom-table" style="font-size: 13px;">
                <thead>
                  <tr>
                    <th>Người giao việc</th>
                    <th>Người nhận việc</th>
                    <th>Hạn hoàn thành</th>
                    <th>Chỉ đạo chi tiết</th>
                    <th>Tiến độ</th>
                  </tr>
                </thead>
                <tbody>
                  <% assignments.forEach(function(item) { %>
                    <tr>
                      <td style="font-weight: 600;"><%= item.assigned_by.full_name %></td>
                      <td style="font-weight: 600; color: var(--primary);"><%= item.assigned_to.full_name %></td>
                      <td><%= new Date(item.deadline).toLocaleDateString('vi-VN') %></td>
                      <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= item.instructions || 'Theo đúng chuyên môn.' %></td>
                      <td>
                        <% if (item.status === 'completed') { %>
                          <span class="badge badge-success" style="font-size: 10px;">Xong</span>
                        <% } else { %>
                          <span class="badge badge-warning" style="font-size: 10px;">Chờ xử lý</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <!-- Outgoing details -->
      <div class="panel">
        <div class="panel-header">
          <h3 class="panel-title">📤 Chi tiết thông tin gửi đi</h3>
        </div>
        <div class="panel-body">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; font-size: 14px;">
            <div>Nơi tiếp nhận công văn: <strong><%= outgoing_info ? outgoing_info.recipient_agency : 'N/A' %></strong></div>
            <div>Lãnh đạo ký ban hành: <strong><%= outgoing_info ? outgoing_info.signer_name : 'N/A' %></strong></div>
            <div>Trạng thái gửi phát hành: <span class="badge badge-success">Thành công</span></div>
            <div>Thời gian phát hành: <strong><%= new Date(document.issued_date).toLocaleDateString('vi-VN') %></strong></div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Timeline of progress / Process log -->
    <div class="panel">
      <div class="panel-header">
        <h3 class="panel-title">⏳ Nhật ký tiến trình & Lịch sử Luân chuyển (Workflow Logs)</h3>
      </div>
      <div class="panel-body">
        <div class="timeline">
          <% process_logs.forEach(function(log) { %>
            <% 
              let marker_class = '';
              if (log.action_taken === 'khởi tạo') marker_class = 'primary';
              else if (log.action_taken === 'bàn giao') marker_class = 'warning';
              else if (log.action_taken === 'hoàn thành') marker_class = 'success';
            %>
            <div class="timeline-item">
              <div class="timeline-marker <%= marker_class %>"></div>
              <div class="timeline-content">
                <div class="timeline-header">
                  <span class="timeline-actor"><%= log.user_id ? log.user_id.full_name : 'Hệ thống' %></span>
                  <span class="timeline-time"><%= new Date(log.action_time).toLocaleString('vi-VN') %></span>
                </div>
                <div class="timeline-body">
                  <span style="font-weight: 700; text-transform: uppercase; font-size: 11px; margin-right: 6px; padding: 2px 6px; background-color: var(--border); border-radius: var(--radius-sm);">
                    <%= log.action_taken %>
                  </span>
                  <%= log.action_details %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>

    <!-- Staff comments & feedback exchange -->
    <div class="panel">
      <div class="panel-header">
        <h3 class="panel-title">💬 Trao đổi nội bộ & Cập nhật tiến trình</h3>
      </div>
      <div class="panel-body">
        
        <!-- Comments list -->
        <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 24px;">
          <% if (comments.length === 0) { %>
            <div style="text-align: center; color: var(--text-muted); font-size: 13px; padding: 16px 0;">
              Chưa có ý kiến trao đổi nào về công văn này.
            </div>
          <% } else { %>
            <% comments.forEach(function(cmt) { %>
              <div style="display: flex; gap: 16px; align-items: flex-start; padding: 12px 16px; background-color: var(--bg-tertiary); border-radius: var(--radius-md);">
                <div class="avatar" style="width: 32px; height: 32px; font-size: 13px;">
                  <%= cmt.user_id.full_name.charAt(0).toUpperCase() %>
                </div>
                <div style="flex: 1;">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <span style="font-weight: 700; font-size: 13px;"><%= cmt.user_id.full_name %></span>
                    <span style="font-size: 11px; color: var(--text-muted);"><%= new Date(cmt.comment_time).toLocaleString('vi-VN') %></span>
                  </div>
                  <div style="font-size: 13.5px; color: var(--text-secondary); line-height: 1.4;"><%= cmt.comment_text %></div>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <!-- Add comment form -->
        <% if (document.status !== 'completed') { %>
          <form action="/documents/<%= document.id %>/comments" method="POST" style="display: flex; gap: 12px; align-items: flex-start;">
            <div class="avatar" style="width: 36px; height: 36px; font-size: 14px;">
              <%= current_user.full_name.charAt(0).toUpperCase() %>
            </div>
            <div style="flex: 1; display: flex; flex-direction: column; gap: 8px;">
              <textarea name="comment_text" class="form-control" rows="2" placeholder="Ghi nhận tiến độ hoặc viết ý kiến đóng góp ý chỉ đạo..." required></textarea>
              <button type="submit" class="btn btn-secondary btn-sm" style="align-self: flex-end;">✔️ Gửi ý kiến cập nhật</button>
            </div>
          </form>
        <% } %>

      </div>
    </div>

  </div>

  <!-- RIGHT SIDE: WORKFLOW ACTIONS -->
  <div>
    
    <!-- Assignment Action (For Leaders / Office staff) -->
    <% if (document.status !== 'completed' && document.doc_type === 'incoming') { %>
      <% if (current_user.roles.includes('admin') || current_user.roles.includes('manager') || current_user.roles.includes('office')) { %>
        
        <div class="panel" style="margin-bottom: 24px;">
          <div class="panel-header" style="background-color: var(--primary-glow); border-bottom-color: rgba(37,99,235,0.25);">
            <h3 class="panel-title" style="color: var(--primary);">👥 Bàn giao giao việc</h3>
          </div>
          <div class="panel-body">
            <form action="/documents/<%= document.id %>/assign" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn bàn giao chuyển xử lý công văn này cho cán bộ phụ trách?');">
              
              <!-- Chọn người nhận việc -->
              <div class="form-group">
                <label for="assigned_to" class="form-label required">Cán bộ phụ trách xử lý</label>
                <select id="assigned_to" name="assigned_to" class="form-control" required>
                  <option value="">-- Chọn cán bộ --</option>
                  <% active_users.forEach(function(u) { %>
                    <% if (u.id !== current_user.id) { %>
                      <option value="<%= u.id %>"><%= u.full_name %> (<%= u.email %>)</option>
                    <% } %>
                  <% }); %>
                </select>
              </div>

              <!-- Hạn chốt hoàn thành -->
              <div class="form-group">
                <label for="deadline" class="form-label required">Thời hạn hoàn thành</label>
                <input type="date" id="deadline" name="deadline" class="form-control" required>
              </div>

              <!-- Chỉ đạo chi tiết -->
              <div class="form-group" style="margin-bottom: 24px;">
                <label for="instructions" class="form-label">Nội dung chỉ đạo của lãnh đạo</label>
                <textarea id="instructions" name="instructions" class="form-control" rows="3" placeholder="Nhập định hướng xử lý công văn, hướng chuyển giao chi tiết..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary" style="width: 100%; font-size: 13px;">👥 Xác nhận chuyển xử lý</button>
            </form>
          </div>
        </div>
        
      <% } %>
    <% } %>

    <!-- Closure Action -->
    <% if (document.status !== 'completed') { %>
      <% if (current_user.roles.includes('admin') || current_user.roles.includes('manager') || current_user.roles.includes('office')) { %>
        
        <div class="panel" style="border-color: var(--success); overflow: hidden;">
          <div class="panel-header" style="background-color: var(--success-bg); border-bottom-color: rgba(16,185,129,0.25);">
            <h3 class="panel-title" style="color: var(--success-text);">✔️ Đóng hồ sơ công văn</h3>
          </div>
          <div class="panel-body" style="text-align: center; padding: 24px 20px;">
            <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 20px;">
              Bấm xác nhận hoàn thành xử lý khi đã có văn bản trả lời chính thức hoặc ý kiến chỉ đạo đã được các cán bộ thực thi xong xuôi.
            </p>
            <form action="/documents/<%= document.id %>/close" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn HOÀN THÀNH xử lý và ĐÓNG hồ sơ công văn này? Thao tác này sẽ khóa các ý kiến thảo luận và bàn giao.');">
              <button type="submit" class="btn btn-success" style="width: 100%; font-size: 13px;">🔒 Hoàn thành & Đóng hồ sơ</button>
            </form>
          </div>
        </div>

      <% } %>
    <% } else { %>
      
      <div class="panel" style="background-color: var(--bg-tertiary); border-color: var(--border); padding: 24px; text-align: center;">
        <div style="font-size: 32px; margin-bottom: 8px;">🔒</div>
        <h4 style="font-family: var(--font-title); font-weight: 700;">HỒ SƠ ĐÃ KHÓA</h4>
        <p style="font-size: 12px; color: var(--text-secondary); margin-top: 4px; line-height: 1.4;">
          Hồ sơ công văn này đã hoàn thành xử lý và khóa truy vết vào lúc <%= new Date(document.updatedAt).toLocaleString('vi-VN') %>.
        </p>
      </div>

    <% } %>

  </div>

</div>

<!-- Beautiful Document Preview Modal Overlay -->
<div id="doc-preview-modal" class="modal-overlay" style="display: none;">
  <div class="modal-card">
    <div class="modal-topbar">
      <div class="modal-file-info">
        <span class="file-icon">📄</span>
        <div>
          <h4 id="preview-filename" class="preview-title">Document.pdf</h4>
          <span id="preview-filesize" class="preview-subtitle">154KB</span>
        </div>
      </div>
      <div class="modal-actions-group">
        <span class="badge badge-success" style="font-size: 10px; padding: 4px 10px; letter-spacing: 0;">🛡️ ĐÃ XÁC THỰC CHỮ KÝ SỐ</span>
        <button class="btn btn-secondary btn-sm" onclick="triggerMockDownload()" style="padding: 6px 12px; font-size: 12px;">📥 Tải xuống</button>
        <button class="modal-close-btn" onclick="closeDocPreview()">&times;</button>
      </div>
    </div>
    
    <div class="preview-viewer-body">
      <!-- Simulated PDF Sidebar -->
      <div class="viewer-sidebar">
        <div class="thumbnail-item active">
          <div class="thumb-page">1</div>
          <span>Trang 1</span>
        </div>
        <div class="thumbnail-item" onclick="alert('Bản scan công văn chỉ gồm 01 trang tài liệu chính thức.')">
          <div class="thumb-page">2</div>
          <span>Phụ lục</span>
        </div>
      </div>
      
      <!-- Simulated PDF Page Sheet -->
      <div class="viewer-main">
        <div class="pdf-page-sheet">
          <div class="pdf-header">
            <div style="font-weight: 700; font-size: 13px; text-transform: uppercase; color: #1e3a8a; letter-spacing: 0.5px;">CÔNG TY CỔ PHẦN CÔNG NGHỆ VN168</div>
            <div style="font-size: 10px; color: #64748b; border-top: 1.5px solid #cbd5e1; padding-top: 3px; width: 160px; margin: 4px auto 0; font-weight: 600;">HỘI ĐỒNG TUYỂN DỤNG VÀ ĐÀO TẠO</div>
          </div>
          
          <div class="pdf-meta-row" style="margin-top: 36px; color: #334155; font-size: 13px;">
            <div>Số hiệu công văn: <strong id="preview-doc-number">125/QĐ-UBND</strong></div>
            <div><i>Hà Nội, Ngày <%= new Date(document.issued_date).toLocaleDateString('vi-VN') %></i></div>
          </div>
          
          <div class="pdf-subject" style="margin-top: 32px; border-left: 3px solid #1e3a8a; padding-left: 12px;">
            <h3 style="font-size: 14px; font-weight: 800; color: #1e293b; text-transform: uppercase; margin: 0; letter-spacing: 0.5px;">TRÍCH YẾU NỘI DUNG</h3>
            <p style="font-size: 13.5px; font-weight: 700; color: #334155; margin-top: 6px; line-height: 1.4;" id="preview-doc-summary">
              Quyết định phê duyệt đề án chuyển đổi số VN168 giai đoạn 2026-2030
            </p>
          </div>
          
          <div class="pdf-divider" style="height: 1.5px; background-color: #e2e8f0; margin: 24px 0;"></div>
          
          <div class="pdf-body-text" style="color: #334155; font-size: 14px; line-height: 1.7; text-align: justify;">
            <p><strong>Kính gửi:</strong> Ban Giám đốc và toàn thể Cán bộ công nhân viên Công ty Cổ phần Công nghệ VN168.</p>
            <p style="text-indent: 28px; margin-top: 12px;">Căn cứ vào kế hoạch phát triển nhân lực số, nâng cao năng lực ứng dụng AI nội bộ và đề án tối ưu hóa văn phòng không giấy tờ đã được phê chuẩn trong Đại hội thường niên,</p>
            <p style="text-indent: 28px; margin-top: 12px;">Ban điều hành chính thức quyết định ban hành tài liệu hướng dẫn kỹ thuật chuẩn hóa, luân chuyển văn bản số và chuẩn lập kế hoạch quản trị công việc VN168.</p>
            <p style="text-indent: 28px; margin-top: 12px;">Yêu cầu các đơn vị, phòng ban trực thuộc nhanh chóng tiếp nhận thông tin chỉ đạo chi tiết, phối hợp chặt chẽ và triển khai nghiêm túc các điều khoản nghiệp vụ quy định, phục vụ tiến trình chuyển đổi số toàn diện công ty.</p>
          </div>
          
          <div class="pdf-signatures-row" style="margin-top: auto; padding-top: 48px;">
            <div style="text-align: center; width: 200px;">
              <span style="font-size: 11px; font-weight: 700; color: #64748b;">NƠI NHẬN:</span>
              <div style="font-size: 10px; text-align: left; margin-top: 8px; color: #64748b; line-height: 1.5; font-weight: 500; padding-left: 8px;">
                - Ban Giám đốc;<br>
                - Khối Công nghệ & Đào tạo;<br>
                - Lưu VP, Văn thư.
              </div>
            </div>
            
            <div style="text-align: center; position: relative; width: 240px; display: flex; flex-direction: column; align-items: center;">
              <span style="font-size: 11px; font-weight: 700; color: #1e293b; letter-spacing: 0.5px;">BAN HÀNH CHÍNH THỨC</span>
              <div style="font-size: 10px; color: #ef4444; margin-top: 4px; font-weight: 700;">CHỮ KÝ SỐ HỢP LỆ</div>
              
              <!-- Red Circular stamp simulation -->
              <div class="pdf-digital-stamp">
                <div class="stamp-inner">VN168</div>
                <div class="stamp-text">ĐÃ KÝ SỐ</div>
              </div>
              
              <div style="font-weight: 800; font-size: 12px; color: #1e293b; margin-top: 2px;">Văn phòng Số VN168</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="modal-footer-bar">
      <div style="font-size: 11.5px; color: var(--text-secondary); display: flex; align-items: center; gap: 8px; font-weight: 500;">
        <span>🔒 Bảo mật Audit Trails</span>
        <span>|</span>
        <span>Người đang xem: <strong id="preview-username" style="color: var(--primary);"><%= current_user.full_name %></strong></span>
      </div>
      <div style="font-size: 11px; color: var(--primary); font-weight: 700; letter-spacing: 0.5px;">
        HỆ THỐNG QUẢN LÝ CÔNG VĂN SỐ VN168
      </div>
    </div>
  </div>
</div>

<!-- Beautiful Toast In-app Notification -->
<div id="toast-notify" class="toast-container" style="display: none;">
  <span id="toast-message">Đã tải xuống tài liệu thành công!</span>
</div>

<style>
/* Document Preview Modal Styles */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.7);
  backdrop-filter: blur(6px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  animation: fadeIn 0.2s ease-out;
}

.modal-card {
  background-color: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45);
  width: 100%;

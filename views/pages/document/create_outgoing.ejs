<div class="page-header">
  <div>
    <h1 class="page-title">Đăng ký & Phát hành Công văn Đi</h1>
    <p class="page-subtitle">Khai báo hồ sơ công văn đi của tổng công ty gửi tới các đối tác, cơ quan ban ngành.</p>
  </div>
  <a href="/documents" class="btn btn-secondary">
    ➔ Quay lại danh sách
  </a>
</div>

<div class="panel" style="max-width: 800px; margin: 0 auto;">
  <div class="panel-header">
    <h3 class="panel-title">Phiếu phát hành công văn đi</h3>
  </div>
  <div class="panel-body">
    <form action="/documents/create-outgoing" method="POST">
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        
        <!-- Số / Ký hiệu đi -->
        <div class="form-group">
          <label for="doc_number" class="form-label required">Số phát hành / Ký hiệu đi</label>
          <input type="text" id="doc_number" name="doc_number" class="form-control" placeholder="Ví dụ: 89/CV-VN168" value="<%= typeof form_data !== 'undefined' ? form_data.doc_number || '' : '' %>" required>
          <% if (typeof errors !== 'undefined' && errors.doc_number) { %>
            <span class="form-error"><%= errors.doc_number %></span>
          <% } %>
        </div>

        <!-- Người ký ban hành -->
        <div class="form-group">
          <label for="signer_name" class="form-label required">Người ký ban hành</label>
          <input type="text" id="signer_name" name="signer_name" class="form-control" placeholder="Họ tên lãnh đạo ký duyệt" value="<%= typeof form_data !== 'undefined' ? form_data.signer_name || '' : '' %>" required>
          <% if (typeof errors !== 'undefined' && errors.signer_name) { %>
            <span class="form-error"><%= errors.signer_name %></span>
          <% } %>
        </div>
        
      </div>

      <!-- Trích yếu nội dung -->
      <div class="form-group">
        <label for="summary" class="form-label required">Trích yếu nội dung công văn đi</label>
        <textarea id="summary" name="summary" class="form-control" rows="3" placeholder="Tóm tắt ngắn gọn mục đích văn bản phát hành" required><%= typeof form_data !== 'undefined' ? form_data.summary || '' : '' %></textarea>
        <% if (typeof errors !== 'undefined' && errors.summary) { %>
          <span class="form-error"><%= errors.summary %></span>
        <% } %>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        
        <!-- Nơi nhận công văn -->
        <div class="form-group">
          <label for="recipient_agency" class="form-label required">Nơi nhận / Đơn vị tiếp nhận</label>
          <input type="text" id="recipient_agency" name="recipient_agency" class="form-control" placeholder="Tên cơ quan, doanh nghiệp nhận" value="<%= typeof form_data !== 'undefined' ? form_data.recipient_agency || '' : '' %>" required>
          <% if (typeof errors !== 'undefined' && errors.recipient_agency) { %>
            <span class="form-error"><%= errors.recipient_agency %></span>
          <% } %>
        </div>

        <!-- Ngày phát hành -->
        <div class="form-group">
          <label for="issued_date" class="form-label required">Ngày phát hành chính thức</label>
          <input type="date" id="issued_date" name="issued_date" class="form-control" value="<%= typeof form_data !== 'undefined' ? form_data.issued_date || '' : '' %>" required>
          <% if (typeof errors !== 'undefined' && errors.issued_date) { %>
            <span class="form-error"><%= errors.issued_date %></span>
          <% } %>
        </div>
        
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        
        <!-- Độ khẩn -->
        <div class="form-group">
          <label for="urgency" class="form-label required">Độ ưu tiên / Độ khẩn</label>
          <select id="urgency" name="urgency" class="form-control" required>
            <option value="normal" <%= typeof form_data !== 'undefined' && form_data.urgency === 'normal' ? 'selected' : '' %>>Bình thường</option>
            <option value="low" <%= typeof form_data !== 'undefined' && form_data.urgency === 'low' ? 'selected' : '' %>>Thấp</option>
            <option value="high" <%= typeof form_data !== 'undefined' && form_data.urgency === 'high' ? 'selected' : '' %>>Khẩn</option>
            <option value="express" <%= typeof form_data !== 'undefined' && form_data.urgency === 'express' ? 'selected' : '' %>>Hỏa tốc</option>
          </select>
        </div>

        <!-- Độ mật -->
        <div class="form-group">
          <label for="confidentiality" class="form-label required">Độ bảo mật thông tin</label>
          <select id="confidentiality" name="confidentiality" class="form-control" required>
            <option value="normal" <%= typeof form_data !== 'undefined' && form_data.confidentiality === 'normal' ? 'selected' : '' %>>Bình thường</option>
            <option value="confidential" <%= typeof form_data !== 'undefined' && form_data.confidentiality === 'confidential' ? 'selected' : '' %>>Công văn mật</option>
            <option value="top_secret" <%= typeof form_data !== 'undefined' && form_data.confidentiality === 'top_secret' ? 'selected' : '' %>>Tối mật</option>
          </select>
        </div>
        
      </div>

      <!-- File Attachment Simulation -->
      <div class="form-group" style="margin-bottom: 32px;">
        <label for="mock_filename" class="form-label">Tài liệu ký duyệt đóng dấu (PDF/DOCX)</label>
        <select id="mock_filename" name="mock_filename" class="form-control">
          <option value="cong_van_di_chinh_thuc_da_ky.pdf">📄 Bản scan công văn đi đóng dấu đỏ chính thức (PDF - 204KB)</option>
          <option value="ke_hoach_sot_2026_outgoing.pdf">📄 Kế hoạch số hóa đào tạo ban hành chính thức (PDF - 920KB)</option>
          <option value="">(Không đính kèm tệp tin)</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%;">Phát hành công văn đi</button>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const summary_input = document.getElementById('summary');
    const urgency_select = document.getElementById('urgency');
    const confidentiality_select = document.getElementById('confidentiality');

    if (summary_input && urgency_select && confidentiality_select) {
      const warning_box = document.createElement('div');
      warning_box.style.display = 'none';
      warning_box.style.marginTop = '12px';
      warning_box.style.padding = '10px 14px';
      warning_box.style.backgroundColor = 'var(--warning-bg)';
      warning_box.style.color = 'var(--warning-text)';
      warning_box.style.fontSize = '12px';
      warning_box.style.fontWeight = '600';
      warning_box.style.borderRadius = 'var(--radius-sm)';
      warning_box.style.border = '1px solid var(--warning)';
      warning_box.style.lineHeight = '1.5';
      summary_input.parentNode.appendChild(warning_box);

      summary_input.addEventListener('input', function() {
        const val = this.value.toLowerCase();
        let is_express = val.includes('hỏa tốc') || val.includes('khẩn cấp') || val.includes('gấp');
        let is_confidential = val.includes('mật') || val.includes('bảo mật') || val.includes('tối mật');

        if (is_express || is_confidential) {
          warning_box.style.display = 'block';
          let warnings = [];

          if (is_express) {
            urgency_select.value = 'express';
            warnings.push('⚡ Tự động chuyển độ khẩn sang "HỎA TỐC" do có từ khóa đặc biệt.');
          }
          if (is_confidential) {
            confidentiality_select.value = 'confidential';
            warnings.push('🔒 Tự động chuyển độ mật sang "CÔNG VĂN MẬT" do có từ khóa bảo mật.');
          }

          warning_box.innerHTML = warnings.join('<br>');
        } else {
          warning_box.style.display = 'none';
        }
      });
    }
  });
</script>

<div class="page-header">
  <div>
    <h1 class="page-title">Quản lý Tài sản & Thiết bị Đào tạo</h1>
    <p class="page-subtitle">Quản lý vòng đời tài sản: Mua sắm, cấp phát, bảo trì sửa chữa, kiểm kê định kỳ và khấu hao vật chất.</p>
  </div>
</div>

<!-- Assets Summary & Action Panels -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 32px; margin-bottom: 28px;">
  
  <!-- Excel import simulation -->
  <div class="panel">
    <div class="panel-header">
      <h3 class="panel-title">📥 Nhập kho thiết bị hàng loạt từ Excel</h3>
    </div>
    <div class="panel-body">
      <form action="#" onsubmit="alert('Đã giả lập import danh sách thiết bị thành công.'); return false;">
        <div class="form-group" style="margin: 0; display: flex; gap: 16px; align-items: flex-end;">
          <div style="flex: 1;">
            <label for="asset_file" class="form-label required">Tải lên file Excel mẫu (.xlsx)</label>
            <select id="asset_file" class="form-control" required>
              <option value="mau_thiet_bi_ai_lab.xlsx">📄 file_excel_mau_thiet_bi_2026.xlsx (32KB)</option>
            </select>
          </div>
          <button type="submit" class="btn btn-success" style="padding: 11px 24px;">📁 Import tài sản</button>
        </div>
      </form>
    </div>
  </div>

  <!-- QR Label quick generator -->
  <div class="panel" style="display: flex; flex-direction: column; justify-content: center; padding: 24px; text-align: center; background-color: var(--primary-glow); border-color: var(--primary);">
    <h3 style="font-size: 15px; margin-bottom: 8px;">In nhãn tem QR Code</h3>
    <p style="font-size: 12.5px; color: var(--text-secondary); margin-bottom: 12px;">
      Tạo hàng loạt nhãn tem QR dán lên thiết bị văn phòng để cán bộ hành chính quét kiểm kê nhanh bằng camera điện thoại.
    </p>
    <button class="btn btn-primary btn-sm" onclick="alert('Tính năng in tem QR hàng loạt đang kết nối máy in nhiệt...')" style="width: 100%;">
      🖨️ Sinh tem QR hàng loạt
    </button>
  </div>

</div>

<!-- Register Newly Purchased Asset Form -->
<div class="panel" style="margin-bottom: 28px;">
  <div class="panel-header" style="background-color: var(--primary-glow); border-bottom-color: rgba(37,99,235,0.25);">
    <h3 class="panel-title" style="color: var(--primary);">➕ Đăng ký Mua mới / Nhập kho tài sản</h3>
  </div>
  <div class="panel-body">
    <form action="/assets/create" method="POST" onsubmit="return confirm('Xác nhận đăng ký nhập kho tài sản mới này vào hệ thống?');">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; align-items: flex-end;">
        
        <div class="form-group" style="margin: 0;">
          <label for="asset_code" class="form-label required">Mã tài sản</label>
          <input type="text" id="asset_code" name="asset_code" class="form-control" placeholder="Ví dụ: TS-LAPTOP-05" required>
        </div>
        
        <div class="form-group" style="margin: 0;">
          <label for="name" class="form-label required">Tên tài sản / Thiết bị</label>
          <input type="text" id="name" name="name" class="form-control" placeholder="Ví dụ: Laptop Dell XPS 15" required>
        </div>

        <div class="form-group" style="margin: 0;">
          <label for="category_name" class="form-label required">Nhóm loại tài sản</label>
          <select id="category_name" name="category_name" class="form-control" required>
            <option value="Thiết bị Đào tạo">Thiết bị Đào tạo</option>
            <option value="Thiết bị Công nghệ">Thiết bị Công nghệ</option>
            <option value="Thiết bị Văn phòng" selected>Thiết bị Văn phòng</option>
          </select>
        </div>
        
      </div>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16px; align-items: flex-end; margin-top: 16px;">
        <div class="form-group" style="margin: 0;">
          <label for="serial_number" class="form-label">Số Serial</label>
          <input type="text" id="serial_number" name="serial_number" class="form-control" placeholder="S/N hoặc Service Tag">
        </div>

        <div class="form-group" style="margin: 0;">
          <label for="purchase_value" class="form-label">Giá trị mua (VND)</label>
          <input type="number" id="purchase_value" name="purchase_value" class="form-control" placeholder="Ví dụ: 25000000" min="0">
        </div>

        <div class="form-group" style="margin: 0;">
          <label for="location" class="form-label">Vị trí ban đầu</label>
          <input type="text" id="location" name="location" class="form-control" value="Kho hành chính">
        </div>

        <button type="submit" class="btn btn-primary btn-sm" style="padding: 11px 24px; width: 100%;">➕ Nhập kho tài sản</button>
      </div>
    </form>
  </div>
</div>

<!-- Assets Table Panel -->
<div class="panel">
  <div class="panel-header">
    <h3 class="panel-title">Danh mục Trang thiết bị tài sản công ty</h3>
  </div>
  <div class="panel-body" style="padding: 0;">
    <div class="table-responsive">
      <table class="custom-table">
        <thead>
          <tr>
            <th>Mã tài sản</th>
            <th>Tên tài sản</th>
            <th>Nhóm loại</th>
            <th>Số Serial</th>
            <th>Ngày mua</th>
            <th>Giá trị mua</th>
            <th>Khấu hao sổ sách (Còn lại)</th>
            <th>Vị trí hiện tại</th>
            <th>Tình trạng</th>
            <th>Thao tác quản lý</th>
          </tr>
        </thead>
        <tbody>
          <% assets.forEach(function(item) { %>
            <tr>
              <td style="font-family: monospace; font-weight: 700; color: var(--primary);"><%= item.asset_code %></td>
              <td style="font-weight: 600;">
                <%= item.name %>
              </td>
              <td><%= item.category_id ? item.category_id.name : 'N/A' %></td>
              <td style="font-family: monospace;"><%= item.serial_number || 'N/A' %></td>
              <td style="font-size: 13px;"><%= new Date(item.purchase_date).toLocaleDateString('vi-VN') %></td>
              <td style="font-weight: 600; color: var(--text-secondary);"><%= item.purchase_value.toLocaleString('vi-VN') %>đ</td>
              <td>
                <div style="font-weight: 700; color: var(--text-primary); font-size: 13.5px;"><%= item.book_value.toLocaleString('vi-VN') %>đ</div>
                <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px; min-width: 140px;">
                  <div style="flex: 1; height: 6px; background-color: var(--bg-tertiary); border-radius: var(--radius-full); overflow: hidden; border: 1px solid var(--border);">
                    <div style="height: 100%; width: <%= item.depreciation_percentage %>%; background-color: <%= item.depreciation_percentage > 50 ? 'var(--success)' : (item.depreciation_percentage > 20 ? 'var(--warning)' : 'var(--danger)') %>;"></div>
                  </div>
                  <span style="font-size: 10px; font-weight: 700; color: var(--text-secondary);"><%= item.depreciation_percentage %>%</span>
                </div>
              </td>
              <td><%= item.location || 'Kho hành chính' %></td>
              <td>
                <% if (item.status === 'available') { %>
                  <span class="badge badge-success">Sẵn sàng cấp 🟢</span>
                <% } else if (item.status === 'assigned') { %>
                  <span class="badge badge-primary">Đang sử dụng 🔵</span>
                <% } else if (item.status === 'maintenance') { %>
                  <span class="badge badge-warning">Bảo trì sửa chữa 🛠️</span>
                <% } else { %>
                  <span class="badge badge-danger">Hỏng / Thanh lý 🔴</span>
                <% } %>
              </td>
              <td>
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                  <button class="btn btn-secondary btn-sm" onclick="alert('Giả lập in tem nhãn QR của tài sản: <%= item.asset_code %>')" style="padding: 6px 10px; font-size: 11px; margin: 0;">
                    🖨️ Tem QR
                  </button>
                  <form action="/assets/update-status" method="POST" style="display: flex; gap: 6px; align-items: center; margin: 0;" onsubmit="return confirm('Bạn có chắc chắn muốn cập nhật trạng thái tài sản <%= item.name %>?');">
                    <input type="hidden" name="id" value="<%= item.id %>">
                    <select name="status" style="padding: 5px 8px; font-size: 11.5px; border-radius: var(--radius-sm); border: 1px solid var(--border); background-color: var(--bg-secondary); color: var(--text-primary); outline: none;">
                      <option value="available" <%= item.status === 'available' ? 'selected' : '' %>>Sẵn sàng</option>
                      <option value="assigned" <%= item.status === 'assigned' ? 'selected' : '' %>>Sử dụng</option>
                      <option value="maintenance" <%= item.status === 'maintenance' ? 'selected' : '' %>>Bảo trì</option>
                      <option value="broken" <%= item.status === 'broken' ? 'selected' : '' %>>Hỏng/Lý</option>
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm" style="padding: 6px 10px; font-size: 11px; margin: 0;">Lưu</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-logo">VN168</div>
      <div class="auth-subtitle">Hệ thống Quản lý Nội bộ Doanh nghiệp</div>
      <h3 style="margin-top: 16px; font-weight: 700; font-size: 20px;">Đăng nhập hệ thống</h3>
    </div>

    <!-- Render flash error or success messages -->
    <% if (typeof req !== 'undefined' && req.session && req.session.flash) { %>
      <% if (req.session.flash.success_message) { %>
        <div class="alert alert-success" style="margin-bottom: 24px;">
          <span>✔️</span>
          <div><%= req.session.flash.success_message %></div>
        </div>
      <% } %>
      <% if (req.session.flash.error_message) { %>
        <div class="alert alert-danger" style="margin-bottom: 24px;">
          <span>⚠️</span>
          <div><%= req.session.flash.error_message %></div>
        </div>
      <% } %>
      <% delete req.session.flash; %>
    <% } %>

    <form action="/login" method="POST">
      
      <!-- Email -->
      <div class="form-group">
        <label for="email" class="form-label required">Địa chỉ Email</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="example@company.com" value="<%= typeof form_data !== 'undefined' ? form_data.email || '' : '' %>" required>
        <% if (typeof errors !== 'undefined' && errors.email) { %>
          <span class="form-error"><%= errors.email %></span>
        <% } %>
      </div>

      <!-- Mật khẩu -->
      <div class="form-group" style="margin-bottom: 32px;">
        <label for="password" class="form-label required">Mật khẩu đăng nhập</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="Nhập mật khẩu đăng nhập" required>
        <% if (typeof errors !== 'undefined' && errors.password) { %>
          <span class="form-error"><%= errors.password %></span>
        <% } %>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%;">Đăng nhập</button>
    </form>

    <div style="text-align: center; margin-top: 24px; font-size: 14px; color: var(--text-secondary);">
      Chưa có tài khoản? <a href="/auth/register" style="font-weight: 600;">Đăng ký tài khoản</a>
    </div>
    
    <div style="margin-top: 32px; padding: 12px; background-color: var(--bg-tertiary); border-radius: var(--radius-sm); border: 1px solid var(--border); font-size: 12px; text-align: center; color: var(--text-secondary);">
      <span style="font-weight: 700; color: var(--text-primary);">Demo Accounts:</span> 
      Đăng ký trực tiếp phía trên và chọn vai trò của bạn để trải nghiệm phân quyền đầy đủ!
    </div>
  </div>
</div>

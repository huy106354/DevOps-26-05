<div class="page-header">
  <div>
    <h1 class="page-title">Hệ thống Quản lý Nội bộ VN168</h1>
    <p class="page-subtitle">Chào mừng quay trở lại, <strong><%= current_user.full_name %></strong>. Hãy theo dõi tình hình vận hành dưới đây.</p>
  </div>
</div>

<!-- MODULE 01 & 02 HIGHLIGHT STATS -->
<h3 style="margin-bottom: 16px; font-weight: 700; font-size: 16px; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">📊 Nghiệp Vụ Trọng Tâm (MVP)</h3>
<div class="grid-stats">
  
  <!-- Lớp Đào Tạo -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Lớp tập huấn</div>
      <div class="stat-value"><%= stats.training.total_classes %></div>
      <div class="stat-change"><span class="badge badge-success"><%= stats.training.active_sessions %> đang mở QR</span></div>
    </div>
    <div class="stat-icon">🏫</div>
  </div>

  <!-- Học Viên -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Tổng học viên</div>
      <div class="stat-value"><%= stats.training.total_trainees %></div>
      <div class="stat-change"><span class="badge badge-primary"><%= stats.training.total_certificates %> chứng nhận</span></div>
    </div>
    <div class="stat-icon green">🎓</div>
  </div>

  <!-- Công Văn Đến -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Công văn đến</div>
      <div class="stat-value"><%= stats.documents.total_incoming %></div>
      <div class="stat-change"><span class="badge badge-warning"><%= stats.documents.active_assignments %> chuyển xử lý</span></div>
    </div>
    <div class="stat-icon orange">📥</div>
  </div>

  <!-- Nhiệm Vụ Quá Hạn -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Văn bản quá hạn</div>
      <div class="stat-value"><%= stats.documents.overdue_documents %></div>
      <div class="stat-change"><span class="badge badge-danger">Cần xử lý gấp</span></div>
    </div>
    <div class="stat-icon red">⚠️</div>
  </div>
  
</div>

<!-- MODULE 03 & 04 PIPELINE STATS -->
<h3 style="margin-bottom: 16px; font-weight: 700; font-size: 16px; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">💼 Vận Hành Bán Hàng & Tài Sản</h3>
<div class="grid-stats">
  
  <!-- Khách Hàng -->
  <div class="stat-card">
    <div>
      <div class="stat-label">CRM Khách hàng</div>
      <div class="stat-value"><%= stats.crm.total_customers %></div>
      <div class="stat-change"><span class="badge badge-info"><%= stats.crm.total_opportunities %> cơ hội bán hàng</span></div>
    </div>
    <div class="stat-icon">💼</div>
  </div>

  <!-- Hợp Đồng Thành Công -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Cơ hội Thắng (Won)</div>
      <div class="stat-value"><%= stats.crm.won_opportunities %></div>
      <div class="stat-change"><span class="badge badge-success">Pipeline tích cực</span></div>
    </div>
    <div class="stat-icon green">✔️</div>
  </div>

  <!-- Tổng Tài Sản -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Quản lý Tài sản</div>
      <div class="stat-value"><%= stats.assets.total_assets %></div>
      <div class="stat-change"><span class="badge badge-primary"><%= stats.assets.assigned_assets %> đã cấp phát</span></div>
    </div>
    <div class="stat-icon orange">🛡️</div>
  </div>

  <!-- Bảo Trì Thiết Bị -->
  <div class="stat-card">
    <div>
      <div class="stat-label">Thiết bị bảo trì</div>
      <div class="stat-value"><%= stats.assets.maintenance_assets %></div>
      <div class="stat-change"><span class="badge badge-warning">Đang sửa chữa</span></div>
    </div>
    <div class="stat-icon red">🛠️</div>
  </div>
  
</div>

<!-- DETAILED PANELS -->
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 32px; margin-top: 16px;">
  
  <!-- Left Side: Recent System Actions (Audit Log) -->
  <div class="panel">
    <div class="panel-header">
      <h3 class="panel-title">Nhật ký Hoạt động Hệ thống (Audit Logs)</h3>
      <span class="badge badge-primary">Truy vết 5 thao tác mới nhất</span>
    </div>
    <div class="panel-body" style="padding: 0;">
      <% if (latest_logs.length === 0) { %>
        <div style="padding: 32px; text-align: center; color: var(--text-muted);">
          Chưa có nhật ký hoạt động nào được ghi lại.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="custom-table">
            <thead>
              <tr>
                <th>Người thực hiện</th>
                <th>Phân hệ</th>
                <th>Hành động</th>
                <th>Mã hồ sơ</th>
                <th>Thời gian</th>
              </tr>
            </thead>
            <tbody>
              <% latest_logs.forEach(function(log) { %>
                <tr>
                  <td style="font-weight: 600;">
                    <%= log.actor_id ? log.actor_id.full_name : 'Hệ thống' %>
                  </td>
                  <td>
                    <span class="badge badge-info"><%= log.module %></span>
                  </td>
                  <td style="font-weight: 500; text-transform: uppercase; font-size: 13px;">
                    <%= log.action %>
                  </td>
                  <td style="font-family: monospace;">
                    #<%= log.record_id || 'N/A' %>
                  </td>
                  <td style="color: var(--text-secondary); font-size: 13px;">
                    <%= new Date(log.createdAt).toLocaleString('vi-VN') %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Right Side: Quick Action & Alerts -->
  <div>
    
    <!-- Quick Actions -->
    <div class="panel" style="margin-bottom: 24px;">
      <div class="panel-header">
        <h3 class="panel-title">Hành động nhanh</h3>
      </div>
      <div class="panel-body" style="display: flex; flex-direction: column; gap: 12px;">
        
        <% if (current_user.roles.includes('admin') || current_user.roles.includes('manager') || current_user.roles.includes('training')) { %>
          <a href="/training/classes" class="btn btn-primary" style="justify-content: flex-start;">
            <span>🏫</span> Quản lý Lớp tập huấn
          </a>
        <% } %>
        
        <% if (current_user.roles.includes('admin') || current_user.roles.includes('manager') || current_user.roles.includes('office')) { %>
          <a href="/documents" class="btn btn-secondary" style="justify-content: flex-start;">
            <span>📥</span> Quản lý Công văn Đi/Đến
          </a>
        <% } %>

        <% if (current_user.roles.includes('admin') || current_user.roles.includes('manager') || current_user.roles.includes('sales')) { %>
          <a href="/crm/customers" class="btn btn-secondary" style="justify-content: flex-start;">
            <span>💼</span> Mở CRM Kinh doanh
          </a>
        <% } %>

        <% if (current_user.roles.includes('admin') || current_user.roles.includes('manager') || current_user.roles.includes('assets')) { %>
          <a href="/assets/items" class="btn btn-secondary" style="justify-content: flex-start;">
            <span>🛠️</span> Quản lý Trang thiết bị
          </a>
        <% } %>
        
      </div>
    </div>

    <!-- Active Notifications Drawer -->
    <div class="panel">
      <div class="panel-header">
        <h3 class="panel-title">Thông báo cá nhân</h3>
      </div>
      <div class="panel-body" style="display: flex; flex-direction: column; gap: 12px; max-height: 280px; overflow-y: auto;">
        <% if (active_notifications.length === 0) { %>
          <div style="padding: 16px; text-align: center; color: var(--text-muted); font-size: 13px;">
            Không có thông báo mới chưa đọc.
          </div>
        <% } else { %>
          <% active_notifications.forEach(function(notif) { %>
            <div style="padding: 12px; background-color: var(--bg-tertiary); border-radius: var(--radius-sm); border-left: 3px solid var(--primary);">
              <div style="font-weight: 700; font-size: 13px;"><%= notif.title %></div>
              <div style="font-size: 12px; color: var(--text-secondary); margin-top: 4px;"><%= notif.content %></div>
              <div style="font-size: 10px; color: var(--text-muted); text-align: right; margin-top: 6px;"><%= new Date(notif.createdAt).toLocaleDateString('vi-VN') %></div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
    
  </div>
  
</div>

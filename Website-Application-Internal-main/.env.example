# ------------------------------------------------------------------------------
# VN168 INTERNAL WEB APPLICATION - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and modify the values to match your environment.
# ------------------------------------------------------------------------------

# General App Settings
NODE_ENV=development
PORT=1337

# Database Adapter Configuration
# - Use 'sails-disk' for instant local file-based database (No setup required!)
# - Use 'sails-postgresql' to connect to an external PostgreSQL database
DB_ADAPTER=sails-disk

# PostgreSQL Connection Configuration
# Mapped custom host port is 5426.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For local host connection:
DATABASE_URL=postgresql://postgres:vn168_secret_password@localhost:5426/vn168_internal_db
# For inside docker-compose network connection (uses container service name):
# DATABASE_URL=postgresql://postgres:vn168_secret_password@db:5432/vn168_internal_db

# Redis Cache Service Configuration
# Mapped custom host port is 6376.
# Leaves this blank to fall back automatically to In-Memory cache for local dev.
# For local host connection:
REDIS_URL=redis://localhost:6376
# For inside docker-compose network connection (uses container service name):
# REDIS_URL=redis://cache:6379

# Session Security Configuration
# Change this to a strong random string in your production environment!
SESSION_SECRET=vn168_session_security_secret_random_string
